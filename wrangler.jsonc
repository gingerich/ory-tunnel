{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ory-tunnel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "id.gingerich.io", "custom_domain": true }],
  // Only reachable via the custom domain.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APPLICATION_ORIGIN": "https://id.gingerich.io",
    "ORY_PROJECT_HOST": "busy-elbakyan-18hqdd1uzu.projects.oryapis.com"
  },
  // Set with `devbox run secrets`; read from the environment in local dev.
  "secrets": { "required": ["ORY_API_KEY"] },
  "observability": { "enabled": true }
}
